---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { hasDetailPage, splitTitle } from '../../data/categories';

export async function getStaticPaths() {
  const all = (await getCollection('work'))
    .filter(w => hasDetailPage(w.data.category))
    .sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { name, subtitle } = splitTitle(d.title);
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary} image={d.cover}>
  <main class="wrap case">
    <a class="back" href={`/work/?c=${encodeURIComponent(d.category)}`}>← {d.category}</a>

    <header class="case-head">
      <p class="kicker">{d.company ? `${d.company}・` : ''}{d.type}</p>
      <h1>{name}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <p class="summary">{d.summary}</p>
      <dl class="meta">
        <div><dt>期間</dt><dd>{d.period}</dd></div>
        <div><dt>角色</dt><dd>{d.role}</dd></div>
        <div><dt>分類</dt><dd>{d.category}</dd></div>
      </dl>
      {d.metrics.length > 0 && (
        <div class="metrics">
          {d.metrics.map(m => <div><b>{m.value}</b><span>{m.label}</span></div>)}
        </div>
      )}
      {d.links.length > 0 && (
        <div class="case-links">
          {d.links.map(l => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>)}
        </div>
      )}
    </header>

    {d.cover && <figure class="cover glass"><img src={d.cover} alt={d.coverAlt} /></figure>}

    <article class:list={["prose", "glass", { "show-todo": import.meta.env.DEV, compact: d.compactImages }]}>
      <Content />
    </article>

    <nav class="pager" aria-label="其他作品">
      {prev ? <a class="glass" href={`/work/${prev.id}/`}><span>← 上一個</span><b>{splitTitle(prev.data.title).name}</b></a> : <span />}
      {next ? <a class="glass next" href={`/work/${next.id}/`}><span>下一個 →</span><b>{splitTitle(next.data.title).name}</b></a> : <span />}
    </nav>
  </main>
</Base>

<style>
  /* One centred column: header, cover, article and pager share the same edges. */
  .case { width: min(860px, calc(100% - 32px)); padding-top: 130px; position: relative; z-index: 1; }
  .back { display: inline-block; text-decoration: none; font-size: 14px; color: var(--muted); margin-bottom: 28px; }
  .back:hover { color: var(--accent); }
  .case-head { max-width: 100%; }
  .kicker { font-size: 13px; letter-spacing: .12em; color: var(--muted); margin-bottom: 10px; }
  h1 { font-size: clamp(30px, 5vw, 50px); line-height: 1.25; margin-bottom: 6px; }
  .subtitle { font-size: clamp(18px, 2.4vw, 24px); font-weight: 500; opacity: .82; margin-bottom: 18px; }
  .summary { font-size: clamp(17px, 2vw, 20px); color: var(--muted); line-height: 1.7; }
  .meta { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 12px 40px; margin-top: 28px; }
  .meta dt { font-size: 12px; letter-spacing: .15em; color: var(--faint); }
  .meta dd { font-size: 15px; }
  .metrics { display: flex; flex-wrap: wrap; gap: 12px 40px; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line); }
  .metrics b { display: block; font-family: Inter, "Noto Sans TC", sans-serif; font-weight: 300; font-size: clamp(30px, 4vw, 42px); line-height: 1.1; }
  .metrics span { font-size: 13px; color: var(--muted); }
  .case-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  @media (max-width: 640px) { .meta { grid-template-columns: 1fr; } }

  .cover { width: 100%; margin: 40px 0 0; overflow: hidden; padding: 6px; border-radius: 18px; }
  .cover img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; border-radius: 13px; }

  .prose { background: var(--glass-read); padding: clamp(24px, 5vw, 56px); margin-top: 20px; }
  .prose :global(h2) { font-size: clamp(22px, 3vw, 28px); margin: 48px 0 14px; line-height: 1.35; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 19px; margin: 32px 0 8px; }
  .prose :global(p), .prose :global(li) { font-size: 16.5px; line-height: 1.9; }
  .prose :global(p) { margin-bottom: 14px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; margin-bottom: 14px; }
  .prose :global(li) { margin: 4px 0; }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(blockquote) { margin: 20px 0; padding: 4px 0 4px 18px; border-left: 2px solid var(--accent); font-style: italic; color: var(--muted); }
  .prose :global(a) { color: var(--fg); text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .prose :global(img) { width: 100%; height: auto; margin: 28px 0; border-radius: 14px; border: 1px solid var(--line); }
  .prose.compact :global(img) { max-width: 520px; margin: 24px auto; display: block; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 16px 0 24px; font-size: 15px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { font-size: 13px; color: var(--muted); font-weight: 600; }
  /* 待補 notes are reminders for the author: shown in local preview only, hidden on the live site. */
  .prose :global(.todo) { display: none; }
  .prose.show-todo :global(.todo) {
    display: block;
    font-size: 14px; line-height: 1.7; color: var(--muted); padding: 12px 16px; margin: 16px 0;
    border: 1px dashed color-mix(in srgb, var(--pink) 60%, transparent); border-radius: 12px; background: color-mix(in srgb, var(--pink) 7%, transparent);
  }
  .prose :global(.todo)::before { content: "📝 "; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px; }
  .pager a { text-decoration: none; padding: 20px 24px; display: flex; flex-direction: column; gap: 4px; transition: border-color .2s; }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; }
  .pager span { font-size: 13px; color: var(--muted); }
  .pager b { font-size: 15px; font-weight: 600; }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } .pager .next { text-align: left; } }
</style>
