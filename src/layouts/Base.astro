---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ParticleField from '../components/ParticleField.astro';
import Social from '../components/Social.astro';
import { categories } from '../data/categories';
import { data, ui, localize, categoryLabel, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  field?: 'hero' | 'ambient';
  image?: string;
}
const {
  lang = 'zh',
  title,
  description = "UI/UX Designer & Product Planner. I turn fuzzy ideas into clear specs and shipped products, from UX design to AI-assisted builds.",
  field = 'ambient',
  image = '/og.png',
} = Astro.props;
const t = ui[lang];
const { profile } = data[lang];
const L = (p: string) => localize(lang, p);

// Share titles use the brand name only (no full name): "WEN．UI/UX Designer & Product Planner".
const brand = `WEN．${profile.title}`;
// Inner pages: "Page name｜WEN · UI/UX & Product".
const fullTitle = title ? `${title}｜WEN · UI/UX & Product` : brand;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Current path without the live site's base ("/wen-portfolio") or the "/en" prefix,
// so nav highlighting and the language switch work locally and online.
const path = ('/' + Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^\//, '')).replace(/^\/en(?=\/|$)/, '') || '/';
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const alternates = { zh: path, en: localize('en', path) };
const siteUrl = (p: string) => new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + p, Astro.site);

const nav = [
  { href: '/work/', label: t.nav.work },
  { href: '/services/', label: t.nav.services },
  { href: '/experience/', label: t.nav.experience },
  { href: '/about/', label: t.nav.about },
];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant" href={siteUrl(alternates.zh)} />
    <link rel="alternate" hreflang="en" href={siteUrl(alternates.en)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl(image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <ParticleField mode={field} />

    <nav class="nav glass" aria-label={t.mainNav}>
      <a class="brand" href={L('/')} aria-label={t.home}><Logo /><span>WEN</span><small class="role">UI/UX &amp; Product</small></a>
      <ul>
        {nav.map(n => <li><a href={L(n.href)} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a></li>)}
        <li><a class="lang-btn" href={alternates[other]} hreflang={other === 'en' ? 'en' : 'zh-Hant'} aria-label={t.switchLabel}>{t.switchTo}</a></li>
        <li><button class="theme-btn" id="themeBtn" type="button" aria-label={t.themeLabel}></button></li>
      </ul>
    </nav>

    <slot />

    <section class="contact glass reveal" id="contact">
      <div class="eyebrow">Contact</div>
      <h2>{t.contactTitle}</h2>
      <p>{t.contactText}</p>
      <a class="btn primary" href={`mailto:${profile.email}`}>{t.contactCta} <span aria-hidden="true">→</span></a>
    </section>

    <footer class="site-footer">
      <div class="foot-grid">
        <div class="foot-brand">
          <a class="brand" href={L('/')} aria-label={t.home}><Logo /><span>WEN</span></a>
          <p class="foot-name">{lang === 'zh' ? `${profile.nameZh}・${profile.nameEn}` : profile.nameEn}</p>
          <p class="foot-title">{profile.title}</p>
          <p class="foot-motto">{profile.motto}</p>
        </div>
        <nav class="foot-nav" aria-label={t.footPages}>
          <h3>{t.footPages}</h3>
          <ul>
            <li><a href={L('/work/')}>{t.footLinks.work}</a></li>
            <li><a href={L('/services/')}>{t.footLinks.services}</a></li>
            <li><a href={L('/experience/')}>{t.footLinks.experience}</a></li>
            <li><a href={L('/about/')}>{t.footLinks.about}</a></li>
          </ul>
        </nav>
        <nav class="foot-nav" aria-label={t.footWork}>
          <h3>{t.footWork}</h3>
          <ul>
            {categories.map(c => <li><a href={`${L('/work/')}?c=${encodeURIComponent(c)}`}>{categoryLabel(lang, c)}</a></li>)}
          </ul>
        </nav>
        <div class="foot-contact">
          <h3>{t.footContact}</h3>
          <Social />
        </div>
      </div>
      <div class="foot-bottom">
        <small>© {new Date().getFullYear()} {profile.nameEn}. All rights reserved.</small>
      </div>
    </footer>


    <style>
      .nav {
        position: fixed; top: 16px; left: 50%; transform: translateX(-50%);
        width: var(--wrap); display: flex; align-items: center; justify-content: space-between;
        padding: 8px 10px 8px 18px; z-index: 10; border-radius: 999px;
        background: var(--glass-bar); backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%);
      }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600; letter-spacing: .08em; }
      .brand :global(svg) { width: 26px; height: 26px; }
      .brand .role { font-size: 13px; font-weight: 400; letter-spacing: .04em; color: var(--muted); padding-left: 12px; border-left: 1px solid var(--line); }
      @media (max-width: 760px) { .brand .role { display: none; } }
      .nav ul { display: flex; gap: 2px; list-style: none; align-items: center; }
      .nav ul a { text-decoration: none; font-size: 14px; padding: 6px 12px; border-radius: 999px; color: var(--muted); transition: color .2s, background .2s; white-space: nowrap; }
      .nav ul a:hover { color: var(--accent); background: var(--glass-strong); }
      .nav ul a[aria-current="page"] { color: var(--accent); background: var(--glass-strong); }
      .nav ul a.lang-btn { margin-left: 6px; padding: 0; width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--line); background: var(--glass-strong); color: var(--fg); font-family: "Noto Sans TC", sans-serif; font-size: 14px; font-weight: 300; letter-spacing: .02em; }
      .nav ul a.lang-btn:hover { border-color: var(--accent); }
      .theme-btn { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); background: var(--glass-strong); color: var(--fg); cursor: pointer; display: grid; place-items: center; margin-left: 4px; }
      .theme-btn :global(svg) { width: 18px; height: 18px; }
      @media (max-width: 480px) {
        .brand span { display: none; }
        .nav { padding-left: 14px; }
        .nav ul { gap: 0; }
        .nav ul a { padding: 6px 5px; font-size: 12.5px; }
        .nav ul a.lang-btn { width: 32px; height: 32px; margin-left: 2px; }
        .theme-btn { width: 32px; height: 32px; margin-left: 2px; }
      }
      .contact { position: relative; z-index: 1; width: var(--wrap); margin: 64px auto 0; padding: clamp(36px, 6vw, 64px) 24px; text-align: center; }
      .contact .eyebrow { justify-content: center; }
      .contact h2 { font-size: clamp(26px, 4vw, 40px); margin-bottom: 8px; }
      .contact p { color: var(--muted); margin-bottom: 24px; }

      .site-footer { position: relative; z-index: 1; width: var(--wrap); margin: 0 auto; padding: 72px 0 28px; }
      .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.3fr; gap: 32px; padding-bottom: 40px; border-bottom: 1px solid var(--line); }
      .foot-name { margin-top: 16px; font-weight: 600; }
      .foot-title { font-size: 14px; color: var(--muted); }
      .foot-motto { margin-top: 12px; font-size: 14px; font-style: italic; color: var(--faint); }
      .site-footer h3 { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--faint); font-weight: 600; margin-bottom: 14px; }
      .foot-nav ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
      .foot-nav a { text-decoration: none; font-size: 14px; color: var(--muted); transition: color .2s; }
      .foot-nav a:hover { color: var(--accent); }
      .foot-bottom { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 20px; color: var(--faint); font-size: 12px; }
      @media (max-width: 820px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand, .foot-contact { grid-column: 1 / -1; } }
    </style>

    <script>
      // Theme toggle
      const root = document.documentElement;
      const btn = document.getElementById('themeBtn')!;
      const sun = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
      const moon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches);
      const paint = () => { btn.innerHTML = isDark() ? sun : moon; };
      btn.addEventListener('click', () => {
        root.dataset.theme = isDark() ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
        paint();
        dispatchEvent(new Event('themechange'));
      });
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', paint);
      paint();

      // Keep the work filter (?c=...) when switching language.
      document.querySelector<HTMLAnchorElement>('.lang-btn')?.addEventListener('click', e => {
        if (!location.search) return;
        e.preventDefault();
        location.href = (e.currentTarget as HTMLAnchorElement).href + location.search;
      });

      // Reveal on scroll + count-up numbers
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver(entries => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          en.target.classList.add('in');
          en.target.querySelectorAll<HTMLElement>('[data-count]').forEach(el => {
            const end = Number(el.dataset.count), suf = el.dataset.suffix || '';
            if (reduce) { el.textContent = end + suf; return; }
            const t0 = performance.now();
            const tick = (now: number) => {
              const k = Math.min(1, (now - t0) / 1400), e = 1 - Math.pow(1 - k, 3);
              el.textContent = Math.round(end * e) + suf;
              if (k < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
          io.unobserve(en.target);
        }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    </script>
  </body>
</html>
